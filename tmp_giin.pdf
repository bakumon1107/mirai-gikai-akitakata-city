<script>
  function main_trans(aLng){
    var transUrl = "https://www-city-kawasaki-jp.j-server.com/LUCKAWASAK/ns/w1/"; // 翻訳用URL(共通)

    var rUrl = location.href;
    if(rUrl == ""){
        rUrl = 'https://www.city.kawasaki.jp/';
    }

    var nUrl = transUrl + 'ja' + aLng + '/' + rUrl;

    location.href = nUrl;
    return false;
}
