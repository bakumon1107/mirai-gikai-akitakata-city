{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node -e \"const p=process.env.WEB_PORT||3002;require('child_process').execSync('next dev --turbopack --port '+p,{stdio:'inherit'})\"",
    "build": "next build --turbopack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "test:integration": "dotenv -e ../.env -- vitest run --config vitest.integration.config.mts",
    "test:integration:coverage": "dotenv -e ../.env -- vitest run --config vitest.integration.config.mts --coverage"
  },
